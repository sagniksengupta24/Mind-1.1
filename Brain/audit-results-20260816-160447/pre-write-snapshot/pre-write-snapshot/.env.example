# API authentication token (leave empty to disable auth for local dev)
MIND_API_TOKEN=

# Ollama server URL
OLLAMA_URL=http://127.0.0.1:11434

# Model to use
MIND_MODEL=qwen2.5-coder:7b

# API server port
MIND_API_PORT=8765

# Allowed CORS origin (must match where the frontend runs)
CORS_ORIGIN=http://localhost:3000

# =========================================================================
# Cloud LLM provider (optional) — see docs/llm_providers.md
#
# Everything below is read directly by AgentConfig.build() for the `ask`,
# `chat`, `doctor`, and `serve-api` commands. Leaving LLM_PROVIDER unset
# (or "ollama") keeps the original local-only behavior unchanged; nothing
# below is required.
# =========================================================================

# ollama (default, local) | openrouter | openai_compatible
LLM_PROVIDER=openrouter

# Model ID as the provider names it. Prefer a free ":free" model on
# OpenRouter to start — see https://openrouter.ai/models?max_price=0
# (availability changes over time; don't hardcode this into agent code).
LLM_MODEL=deepseek/deepseek-chat-v3.1:free

# OpenRouter API key (used automatically when LLM_PROVIDER=openrouter)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# Only needed for LLM_PROVIDER=openai_compatible (Together, Groq,
# Fireworks, a self-hosted vLLM/TGI server, ...):
# LLM_BASE_URL=https://api.together.xyz/v1
# LLM_API_KEY=your-key-here

# Comma-separated model IDs tried in order if LLM_MODEL fails (rate
# limit, 5xx, model unavailable). Auth errors never fall through, since
# they won't improve on a different model.
LLM_FALLBACK_MODELS=qwen/qwen3-235b-a22b:free,meta-llama/llama-3.3-70b-instruct:free

# Optional OpenRouter attribution headers (recommended, not required):
# LLM_SITE_URL=https://your-app.example.com
# LLM_APP_NAME=mind01
